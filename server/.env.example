NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Atlas: replace the entire URI, including the database name, with your own.
# A local MongoDB installation also works with this example URI.
MONGODB_URI=mongodb://127.0.0.1:27017/afterimage
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Set to 1 only when production runs behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Backend only. Obtain your own client ID at https://devportal.jamendo.com/
# Leave empty to keep accounts/spaces working with a clear music configuration error.
JAMENDO_CLIENT_ID=

# Optional managed image uploads. All three values are backend-only.
# Find them in your Cloudinary product environment API credentials.
# Console: Settings > API Keys; use the cloud name/key/secret from the same environment.
# This app reads these three individual values, not CLOUDINARY_URL. No upload preset is needed.
# Without these, HTTPS references still work; uploads report configuration required.
CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
